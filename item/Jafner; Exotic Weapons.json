		{
			"name": "Бола",
			"source": "EW",
			"type": "R",
			"rarity": "none",
			"weight": 2,
			"value": 500,
			"weaponCategory": "exotic",
			"property": [
				"EX",
				"L",
				"S"
			],
			"range": "10/40",
			"dmg1": "1d4",
			"dmgType": "B",
			"entries": [
				{
					"type": "entries",
					"name": "Особое",
					"entries": [
						"Попавшее под бола существо Среднего размера или меньше должно преуспеть в спасброске Силы со Сл 10, иначе становится {@condition restrained}, пока не освободится. Бола не действует на бесформенных существ и на существ Большого размера или больше. Существо может действием совершить проверку Силы со Сл 10, освобождая при успехе себя или другое существо в пределах своей досягаемости. Нанесение бола 5 рубящего урона (КД 12) также освобождает существо, не причиняя ему вреда, прекращает эффект и уничтожает болу. Когда вы используете действие, бонусное действие или реакцию для атаки болой, вы можете совершить только одну атаку, независимо от числа атак, которые обычно можете совершить."
					]
				}
			]
		},
