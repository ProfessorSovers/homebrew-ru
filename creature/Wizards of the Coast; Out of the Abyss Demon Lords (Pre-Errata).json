    {
      "name": "Бафомет",
      "source": "OotADemonLords",
      "reprintedAs": [
        "Baphomet|MTF"
      ],
      "_copy": {
        "name": "Бафомет",
        "source": "MTF",
        "_mod": {
          "trait": {
            "mode": "replaceArr",
            "replace": "Charge",
            "items": {
              "name": "Таран",
              "entries": [
                "Если Бафомет перемещается не менее чем на 10 футов по прямой к цели и затем попадает по ней атакой бодания в тот же ход, цель получает дополнительно 22 ({@damage 4d10}) колющего урона. Если цель — существо, она должна преуспеть в спасброске Силы против СЛ {@dc 25}, иначе её отталкивают на расстояние до 10 футов и сбивают с ног {@condition prone}."
              ]
            }
          },
          "action": [
            {
              "mode": "replaceArr",
              "replace": "Heartcleaver",
              "items": {
                "name": "Раскалыватель Сердец",
                "entries": [
                  "{@atk mw} {@hit 17} к попаданию, досягаемость 15 футов, одна цель. {@h}24 ({@damage 4d6 + 10}) рубящего урона."
                ]
              }
            },
            {
              "mode": "replaceArr",
              "replace": "Gore",
              "items": {
                "name": "Бодание",
                "entries": [
                  "{@atk mw} {@hit 17} к попаданию, досягаемость 10 футов, одна цель. {@h}21 {@damage 2d10 + 10}) колющего урона."
                ]
              }
            }
          ]
        },
        "_preserve": {
          "page": true,
          "legendaryGroup": true,
          "hasToken": true,
          "hasFluff": true,
          "hasFluffImages": true
        }
      },
      "hp": {
        "average": 333,
        "formula": "23d12 + 184"
      },
      "token": {
        "name": "Бафомет",
        "source": "MTF"
      }
